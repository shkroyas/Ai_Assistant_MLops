# Copy to .env locally. Never commit real values.
AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_MODEL=gemini-2.5-flash
AGENT_API_KEY=
# Only for a Jupyter HTTPS proxy; these headers never go to FALLBACK_BASE_URL.
AGENT_PROXY_TOKEN=
AGENT_PROXY_COOKIE=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_API_KEY=
FALLBACK_PROXY_TOKEN=
FALLBACK_PROXY_COOKIE=
GEMINI_API_KEY=
# One active key per provider. Comma-separated reserve lists are not auto-rotated.
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEYS=
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
JUDGE_API_KEY=
JUDGE_BASE_URL=
MLFLOW_TRACKING_URI=http://localhost:5000
ASSISTANT_CONFIG=configs/v1.yaml
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
VLLM_API_KEY=
CF_TUNNEL_TOKEN=
AIRFLOW_UID=1000
ASSISTANT_UI_PORT=8501
